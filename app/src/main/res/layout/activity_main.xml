<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#090B12" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Ringo" android:textSize="30sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Your Music, Your Ringtone" android:textColor="#8F9BB3"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
    <EditText android:id="@+id/search" android:hint="Search songs..." android:textColor="#FFFFFF"
        android:textColorHint="#778099" android:backgroundTint="#263044"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="10dp"/>
</LinearLayout>
